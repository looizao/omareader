#!/bin/sh
# Builds, tests, installs and publishes the Android app in android/.
#   bin/android test      JVM unit tests and lint
#   bin/android build     the release APK (R8-shrunk), printed path
#   bin/android install   builds it and installs it on the phone or
#                         emulator adb sees
#   bin/android bundle    the release bundle Play takes, printed path
#   bin/android publish [--dry-run]
#                         sends the bundle from "bundle" to Play's internal
#                         testing track; --dry-run has Play check the whole
#                         release and then throws it away
# Needs a JDK and the Android SDK, found through ANDROID_HOME or
# ~/Android/Sdk; Gradle itself comes through the wrapper. publish needs curl
# and jq, and an OAuth access token for the Play Developer API in
# PLAY_ACCESS_TOKEN (docs/play.md).
set -eu

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
APK="$ROOT/android/app/build/outputs/apk/release/app-release.apk"
AAB="$ROOT/android/app/build/outputs/bundle/release/app-release.aab"
PACKAGE="io.github.looizao.omareader"

sdk() {
  if [ -z "${ANDROID_HOME:-}" ] && [ -d "$HOME/Android/Sdk" ]; then
    ANDROID_HOME="$HOME/Android/Sdk"
  fi
  if [ -z "${ANDROID_HOME:-}" ]; then
    echo "The Android SDK was not found; set ANDROID_HOME." >&2
    exit 1
  fi
  export ANDROID_HOME
}

gradle() {
  sdk
  (cd "$ROOT/android" && ./gradlew --console=plain "$@")
}

# Calls the Play Developer API and prints the reply. The token goes to curl
# on its standard input, so it never shows up in the process list; when Play
# turns a call down, its explanation goes to standard error.
play() {
  method="$1"
  path="$2"
  shift 2
  if ! printf 'header = "Authorization: Bearer %s"\n' "$PLAY_ACCESS_TOKEN" |
    curl --silent --show-error --fail-with-body --config - --output "$reply" \
      -X "$method" "$@" "$API$path"; then
    echo "Play turned down $method $path:" >&2
    cat "$reply" >&2
    echo >&2
    return 1
  fi
  cat "$reply"
}

# An edit that was never committed changes nothing on Play, so whatever
# stops publish early, deleting it just tidies up.
finish() {
  if [ -n "$edit" ]; then
    play DELETE "$edits/$edit" > /dev/null 2>&1 || true
  fi
  rm -f "$reply"
}

publish() {
  dry_run=0
  [ "${1:-}" = "--dry-run" ] && dry_run=1
  API="${PLAY_API:-https://androidpublisher.googleapis.com}"
  edits="/androidpublisher/v3/applications/$PACKAGE/edits"
  edit=""

  if [ -z "${PLAY_ACCESS_TOKEN:-}" ]; then
    echo "Set PLAY_ACCESS_TOKEN to an access token for the Play Developer API." >&2
    exit 1
  fi
  if [ ! -f "$AAB" ]; then
    echo "No bundle at $AAB; run bin/android bundle first." >&2
    exit 1
  fi
  # Play would turn a debug-signed bundle away, but only after the upload.
  if keytool -printcert -jarfile "$AAB" | grep -q "CN=Android Debug"; then
    echo "The bundle is signed with the debug key; set up android/keystore.properties." >&2
    exit 1
  fi
  # The version code counts the commits (see build.gradle.kts).
  if [ "$(git -C "$ROOT" rev-parse --is-shallow-repository)" = true ]; then
    echo "This is a shallow clone, so the version code is wrong; fetch the whole history." >&2
    exit 1
  fi

  reply="$(mktemp)"
  trap finish EXIT
  created="$(play POST "$edits")"
  edit="$(printf '%s' "$created" | jq -er .id)"

  uploaded="$(play POST "/upload$edits/$edit/bundles?uploadType=media" \
    -H "Content-Type: application/octet-stream" --data-binary "@$AAB")"
  code="$(printf '%s' "$uploaded" | jq -er .versionCode)"
  version="$(cat "$ROOT/VERSION")"
  track="$(jq -n --arg name "$version ($code)" --arg code "$code" \
    '{track: "internal", releases: [{name: $name, versionCodes: [$code], status: "completed"}]}')"
  play PUT "$edits/$edit/tracks/internal" \
    -H "Content-Type: application/json" --data-binary "$track" > /dev/null

  if [ "$dry_run" = 1 ]; then
    play POST "$edits/$edit:validate" > /dev/null
    echo "Play accepts $version ($code) for internal testing; nothing was sent to testers."
    return
  fi
  play POST "$edits/$edit:commit" > /dev/null
  edit=""
  echo "Sent $version ($code) to internal testing."
}

case "${1:-}" in
  test)
    gradle testDebugUnitTest lintRelease
    ;;
  build)
    gradle assembleRelease
    echo "Built $APK ($(du -h "$APK" | cut -f1))"
    ;;
  install)
    gradle assembleRelease
    "$ANDROID_HOME/platform-tools/adb" install -r "$APK"
    echo "Installed $APK"
    ;;
  bundle)
    gradle bundleRelease
    echo "Built $AAB ($(du -h "$AAB" | cut -f1))"
    ;;
  publish)
    shift
    publish "$@"
    ;;
  *)
    echo "Usage: bin/android test|build|install|bundle|publish [--dry-run]" >&2
    exit 2
    ;;
esac
