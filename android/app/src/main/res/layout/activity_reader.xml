<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/back"
            style="@style/IconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/chapter_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/speed"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/speed"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/text_size"
            style="@style/IconButton"
            android:contentDescription="@string/text_size"
            android:src="@drawable/ic_text_size" />

        <ImageButton
            android:id="@+id/contents"
            style="@style/IconButton"
            android:contentDescription="@string/contents"
            android:src="@drawable/ic_contents" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/paragraphs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="48dp"
            android:scrollbarStyle="outsideOverlay" />

        <TextView
            android:id="@+id/follow"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/pill"
            android:elevation="4dp"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/back_to_voice"
            android:textColor="@color/on_accent"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <SeekBar
            android:id="@+id/seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="@color/control"
            android:thumbTint="@color/control" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/elapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/previous_chapter"
                style="@style/IconButton"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/previous_chapter"
                android:src="@drawable/ic_previous_chapter" />

            <ImageButton
                android:id="@+id/previous_sentence"
                style="@style/IconButton"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/previous_sentence"
                android:src="@drawable/ic_previous_sentence" />

            <ImageButton
                android:id="@+id/play"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/play_button"
                android:contentDescription="@string/play"
                android:elevation="2dp"
                android:scaleType="center"
                android:src="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/next_sentence"
                style="@style/IconButton"
                android:layout_marginStart="16dp"
                android:contentDescription="@string/next_sentence"
                android:src="@drawable/ic_next_sentence" />

            <ImageButton
                android:id="@+id/next_chapter"
                style="@style/IconButton"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/next_chapter"
                android:src="@drawable/ic_next_chapter" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
